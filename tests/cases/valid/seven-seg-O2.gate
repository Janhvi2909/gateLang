// test: 7-segment decoder at -O2 (Quine–McCluskey), still matches the model
// expect: W604
// check: sevenseg
// opts: O2
// BCD to 7-segment decoder, written as canonical sum of minterms.
// Compile with -O1, then switch to -O2: Quine–McCluskey finds the minimal form.
input b3, b2, b1, b0;
output seg_a, seg_b, seg_c, seg_d, seg_e, seg_f, seg_g;

